{
  "name": "audit-cleaner",
  "version": "1.0.0",
  "description": "",
  "main": "dist/index.js",
  "scripts": {
    "test": "TAP_RCFILE=tap.yml tap",
    "start": "node dist/index.js",
    "dev": "nodemon | pino-pretty",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/*.{js,ts,jsx,tsx,json,css,scss,md,mdx,yaml}\"",
    "build": "rm -rf dist && tsc -p tsconfig.json"
  },
  "nodemonConfig": {
    "ext": "ts,json",
    "exec": "node --import tsx src/index.ts"
  },
  "type": "module",
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.810.0",
    "@aws-sdk/lib-storage": "^3.810.0",
    "dotenv": "^16.5.0",
    "pg": "^8.15.6",
    "pg-query-stream": "^4.10.0",
    "pino": "^9.7.0",
    "pretty-ms": "^9.2.0"
  },
  "devDependencies": {
    "@aws-sdk/types": "^3.804.0",
    "@types/node": "^22.15.17",
    "@types/pg": "^8.15.1",
    "@types/pino": "^7.0.4",
    "@typescript-eslint/eslint-plugin": "^7.5.0",
    "@typescript-eslint/parser": "^7.5.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "nodemon": "^3.0.0",
    "pino-pretty": "^11.3.0",
    "prettier": "^3.2.5",
    "tap": "^18.8.0",
    "ts-node": "^10.9.2",
    "tsx": "^4.7.1",
    "typescript": "^5.8.3"
  }
}
